{
    "entity": {
        "metadata": {
            "noOfInputPorts": 2,
            "noOfOutputPorts": 2
        },

        "inputs": ["s", "r"],
        "outputs": ["q", "qb"],
        "intermediates": ["ns", "nr", "y1", "y2"]
    },

    "Architecture": {

        "metadata": {
            "noOfTotalGates": 6,
            "noOfAndGates": 2,
            "noOforGates": 2,
            "noOfNotGates": 2,
            "noOfXorGates": 0,
            "noOfXnorGates": 0,
            "noOfSignals": 6
        },

        "SignalMapping":
        [
            {"x": "s", "SignalType": "input"},
            {"y": "r", "SignalType": "input"},
            {"qout": "q", "SignalType": "output"},
            {"qbout": "qb", "SignalType": "output"}
        ],

        "Behaviour": [

            {
                "OutputSignal": "ns",
                "gateExpressionInputs": ["x"],
                "gatesUsed": ["not"],
                "expression": "not(x)"
            },

            {
                "OutputSignal": "nr",
                "gateExpressionInputs": ["y"],
                "gatesUsed": ["not"],
                "expression": "not(y)"
            },

            {
                "OutputSignal": "y1",
                "gateExpressionInputs": ["qout", "nr"],
                "gatesUsed": ["and"],
                "expression": "and(qout, nr)"
            },

            {
                "OutputSignal": "qout",
                "gateExpressionInputs": ["x", "y1"],
                "gatesUsed": ["or"],
                "expression": "or(x, y1)"
            },

            {
                "OutputSignal": "y2",
                "gateExpressionInputs": ["qbout", "ns"],
                "gatesUsed": ["and"],
                "expression": "and(qbout, ns)"
            },

            {
                "OutputSignal": "qbout",
                "gateExpressionInputs": ["y", "y2"],
                "gatesUsed": ["or"],
                "expression": "or(y, y2)"
            }

        ]
    }
}