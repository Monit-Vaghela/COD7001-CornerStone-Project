entity decoder {
    inputs : ["S0", "S1", "S2"];
    outputs : ["I0", "I1", "I2", "I3", "I4", "I5", "I6", "I7"];
}

architecture decoder {
    signals : ["S0", "S1", "S2", 
               "I0", "I1", "I2", "I3", "I4", "I5", "I6", "I7"];
    
    signalMapping : [
        "S0" <= "S0",
        "S1" <= "S1",
        "S2" <= "S2",
        "I0" <= "I0",
        "I1" <= "I1",
        "I2" <= "I2",
        "I3" <= "I3",
        "I4" <= "I4",
        "I5" <= "I5",
        "I6" <= "I6",
        "I7" <= "I7"      
    ];

    behaviour {
        I0 <= not(S0) and not(S1) and not(S2);
        I1 <= S0 and not(S1) and not(S2);
        I2 <= not(S0) and S1 and not(S2);
        I3 <= S0 and S1 and not(S2);
        I4 <= not(S0) and not(S1) and S2;
        I5 <= S0 and not(S1) and S2;
        I6 <= not(S0) and S1 and S2;
        I7 <= S0 and S1 and S2;
    }
}