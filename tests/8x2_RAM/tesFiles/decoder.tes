simulator decoder {
    processes {
        process(["S2" <= 0, "S1" <= 0, "S0" <= 0], 1);
        process(["S2" <= 0, "S1" <= 0, "S0" <= 1], 2);
        process(["S2" <= 0, "S1" <= 1, "S0" <= 0], 3);
        process(["S2" <= 0, "S1" <= 1, "S0" <= 1], 4);
        process(["S2" <= 1, "S1" <= 0, "S0" <= 0], 5);
        process(["S2" <= 1, "S1" <= 0, "S0" <= 1], 6);
        process(["S2" <= 1, "S1" <= 1, "S0" <= 0], 7);
        process(["S2" <= 1, "S1" <= 1, "S0" <= 1], 8);
    }
}