simulator FullAdder{
    processes {
        process(["x" <= 0, "y" <= 0, "z" <= 0], 0);
        process(["x" <= 0, "y" <= 0, "z" <= 1], 1);
        process(["x" <= 0, "y" <= 1, "z" <= 0], 2);
        process(["x" <= 0, "y" <= 1, "z" <= 1], 3);
        process(["x" <= 1, "y" <= 0, "z" <= 0], 4);
        process(["x" <= 1, "y" <= 0, "z" <= 1], 5);
        process(["x" <= 1, "y" <= 1, "z" <= 0], 6);
        process(["x" <= 1, "y" <= 1, "z" <= 1], 7);
    }
}