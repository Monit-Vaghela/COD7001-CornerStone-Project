simulator DB2regs {
    processes {

        process(["CLK" <= 0], 1);

        process(["IM" <= 1], 2);

        process(["A7" <= 1, "A6" <= 0, "A5" <= 0, "A4" <= 1,
                 "A3" <= 0, "A2" <= 1, "A1" <= 1, "A0" <= 0], 2);

        process(["CLK" <= 1], 3);
        process(["CLK" <= 0], 4);

        process(["S0" <= 1, "R" <= 1], 5);

        process(["CLK" <= 1], 6);
        process(["CLK" <= 0], 7);

        process(["A7" <= 0, "A6" <= 1, "A5" <= 1, "A4" <= 0,
                 "A3" <= 1, "A2" <= 0, "A1" <= 0, "A0" <= 1], 8);

        process(["S0" <= 0, "R" <= 1], 9);

        process(["CLK" <= 1, "S0" <= 1], 10);

        process(["IM" <= 0], 11);

    }
}