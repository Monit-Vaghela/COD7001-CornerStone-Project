entity regs {
    inputs : ["CLK", "E", "R",
              "D0", "D1", "D2", "D3", "D4", "D5", "D6", "D7"];
    outputs : ["Q0", "Q1", "Q2", "Q3", "Q4", "Q5", "Q6", "Q7"];
    uses ["edff"];
}

architecture regs {
    signals : ["CLK", "E", "R",
               "D0", "D1", "D2", "D3", "D4", "D5", "D6", "D7",
               "Q0", "Q1", "Q2", "Q3", "Q4", "Q5", "Q6", "Q7"];
    signalMapping : [
        "CLK" <= "CLK",
        "E" <= "E",
        "R" <= "R",

        "D0" <= "D0",
        "D1" <= "D1",
        "D2" <= "D2",
        "D3" <= "D3",
        "D4" <= "D4",
        "D5" <= "D5",
        "D6" <= "D6",
        "D7" <= "D7",
        
        "Q0" <= "Q0",
        "Q1" <= "Q1",
        "Q2" <= "Q2",
        "Q3" <= "Q3",
        "Q4" <= "Q4",
        "Q5" <= "Q5",
        "Q6" <= "Q6",
        "Q7" <= "Q7"        
    ];
    behaviour {
        instance EDFF0 of edff (D => D0, CLK => CLK, E => E, Q => Q0, R => R);
        instance EDFF1 of edff (D => D1, CLK => CLK, E => E, Q => Q1, R => R);
        instance EDFF2 of edff (D => D2, CLK => CLK, E => E, Q => Q2, R => R);
        instance EDFF3 of edff (D => D3, CLK => CLK, E => E, Q => Q3, R => R);
        instance EDFF4 of edff (D => D4, CLK => CLK, E => E, Q => Q4, R => R);
        instance EDFF5 of edff (D => D5, CLK => CLK, E => E, Q => Q5, R => R);
        instance EDFF6 of edff (D => D6, CLK => CLK, E => E, Q => Q6, R => R);
        instance EDFF7 of edff (D => D7, CLK => CLK, E => E, Q => Q7, R => R);
    }
}