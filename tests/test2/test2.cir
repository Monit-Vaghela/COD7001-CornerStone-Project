entity andGate{
    inputs : ["a1", "a2", "a3", "a4", "a5", "a6", "a7", "a8"];
    outputs : ["b"];
}

architecture andGate {
    signals : ["x1", "x2", "x3", "x4", "x5", "x6", "x7", "x8", "y"];
    signalMapping : [
        "x1" <= "a1",
        "x2" <= "a2",
        "x3" <= "a3",
        "x4" <= "a4",
        "x5" <= "a5",
        "x6" <= "a6",
        "x7" <= "a7",
        "x8" <= "a8",
        "y" <= "b"
    ];
    behaviour{
        y <= ((x1 and x2) or (x3 and x4)) and ((x5 and x6) or (x7 and x8));
    }

}