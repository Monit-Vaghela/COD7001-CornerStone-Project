entity HalfAdder {
    inputs : ["a", "b"];
    outputs : ["c", "sum"];
    uses ["XorUsingNand"];
}

architecture HalfAdder {
    signals : ["x", "y", "mus", "yrrac"];
    signalMapping : [
        "x" <= "a",
        "y" <= "b",
        "mus" <= "sum",
        "yrrac" <= "c"
    ];
    behaviour {
        instance xorGate of XorUsingNand (A => x, B => y, Y => mus);
        yrrac <= x and y;
    }
}