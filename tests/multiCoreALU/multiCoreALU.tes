simulator multiCoreALU {
    processes {
        // ── Init ─────────────────────────────────────────────────────────
        process(["CLK" <= 0], 1);

        // ── All cores IM=1, set reg0 values (S0=0 default) ───────────────
        process(["C0_IM" <= 1, "C1_IM" <= 1, "C2_IM" <= 1, "C3_IM" <= 1,
                 "C4_IM" <= 1, "C5_IM" <= 1, "C6_IM" <= 1, "C7_IM" <= 1], 2);

        // C0 reg0: 0x00000001
        process(["C0_A31" <= 0, "C0_A30" <= 0, "C0_A29" <= 0, "C0_A28" <= 0,
                 "C0_A27" <= 0, "C0_A26" <= 0, "C0_A25" <= 0, "C0_A24" <= 0,
                 "C0_A23" <= 0, "C0_A22" <= 0, "C0_A21" <= 0, "C0_A20" <= 0,
                 "C0_A19" <= 0, "C0_A18" <= 0, "C0_A17" <= 0, "C0_A16" <= 0,
                 "C0_A15" <= 0, "C0_A14" <= 0, "C0_A13" <= 0, "C0_A12" <= 0,
                 "C0_A11" <= 0, "C0_A10" <= 0, "C0_A9"  <= 0, "C0_A8"  <= 0,
                 "C0_A7"  <= 0, "C0_A6"  <= 0, "C0_A5"  <= 0, "C0_A4"  <= 0,
                 "C0_A3"  <= 0, "C0_A2"  <= 0, "C0_A1"  <= 0, "C0_A0"  <= 1], 2);
        // C1 reg0: 0x0000000F
        process(["C1_A31" <= 0, "C1_A30" <= 0, "C1_A29" <= 0, "C1_A28" <= 0,
                 "C1_A27" <= 0, "C1_A26" <= 0, "C1_A25" <= 0, "C1_A24" <= 0,
                 "C1_A23" <= 0, "C1_A22" <= 0, "C1_A21" <= 0, "C1_A20" <= 0,
                 "C1_A19" <= 0, "C1_A18" <= 0, "C1_A17" <= 0, "C1_A16" <= 0,
                 "C1_A15" <= 0, "C1_A14" <= 0, "C1_A13" <= 0, "C1_A12" <= 0,
                 "C1_A11" <= 0, "C1_A10" <= 0, "C1_A9"  <= 0, "C1_A8"  <= 0,
                 "C1_A7"  <= 0, "C1_A6"  <= 0, "C1_A5"  <= 0, "C1_A4"  <= 0,
                 "C1_A3"  <= 1, "C1_A2"  <= 1, "C1_A1"  <= 1, "C1_A0"  <= 1], 2);
        // C2 reg0: 0x000000FF
        process(["C2_A31" <= 0, "C2_A30" <= 0, "C2_A29" <= 0, "C2_A28" <= 0,
                 "C2_A27" <= 0, "C2_A26" <= 0, "C2_A25" <= 0, "C2_A24" <= 0,
                 "C2_A23" <= 0, "C2_A22" <= 0, "C2_A21" <= 0, "C2_A20" <= 0,
                 "C2_A19" <= 0, "C2_A18" <= 0, "C2_A17" <= 0, "C2_A16" <= 0,
                 "C2_A15" <= 0, "C2_A14" <= 0, "C2_A13" <= 0, "C2_A12" <= 0,
                 "C2_A11" <= 0, "C2_A10" <= 0, "C2_A9"  <= 0, "C2_A8"  <= 0,
                 "C2_A7"  <= 1, "C2_A6"  <= 1, "C2_A5"  <= 1, "C2_A4"  <= 1,
                 "C2_A3"  <= 1, "C2_A2"  <= 1, "C2_A1"  <= 1, "C2_A0"  <= 1], 2);
        // C3 reg0: 0x00001234
        process(["C3_A31" <= 0, "C3_A30" <= 0, "C3_A29" <= 0, "C3_A28" <= 0,
                 "C3_A27" <= 0, "C3_A26" <= 0, "C3_A25" <= 0, "C3_A24" <= 0,
                 "C3_A23" <= 0, "C3_A22" <= 0, "C3_A21" <= 0, "C3_A20" <= 0,
                 "C3_A19" <= 1, "C3_A18" <= 0, "C3_A17" <= 0, "C3_A16" <= 1,
                 "C3_A15" <= 0, "C3_A14" <= 0, "C3_A13" <= 1, "C3_A12" <= 0,
                 "C3_A11" <= 0, "C3_A10" <= 0, "C3_A9"  <= 1, "C3_A8"  <= 1,
                 "C3_A7"  <= 0, "C3_A6"  <= 1, "C3_A5"  <= 0, "C3_A4"  <= 0,
                 "C3_A3"  <= 0, "C3_A2"  <= 0, "C3_A1"  <= 0, "C3_A0"  <= 0], 2);
        // C4 reg0: 0x7FFFFFFF
        process(["C4_A31" <= 0, "C4_A30" <= 1, "C4_A29" <= 1, "C4_A28" <= 1,
                 "C4_A27" <= 1, "C4_A26" <= 1, "C4_A25" <= 1, "C4_A24" <= 1,
                 "C4_A23" <= 1, "C4_A22" <= 1, "C4_A21" <= 1, "C4_A20" <= 1,
                 "C4_A19" <= 1, "C4_A18" <= 1, "C4_A17" <= 1, "C4_A16" <= 1,
                 "C4_A15" <= 1, "C4_A14" <= 1, "C4_A13" <= 1, "C4_A12" <= 1,
                 "C4_A11" <= 1, "C4_A10" <= 1, "C4_A9"  <= 1, "C4_A8"  <= 1,
                 "C4_A7"  <= 1, "C4_A6"  <= 1, "C4_A5"  <= 1, "C4_A4"  <= 1,
                 "C4_A3"  <= 1, "C4_A2"  <= 1, "C4_A1"  <= 1, "C4_A0"  <= 1], 2);
        // C5 reg0: 0x12345678
        process(["C5_A31" <= 0, "C5_A30" <= 0, "C5_A29" <= 0, "C5_A28" <= 1,
                 "C5_A27" <= 0, "C5_A26" <= 0, "C5_A25" <= 1, "C5_A24" <= 0,
                 "C5_A23" <= 0, "C5_A22" <= 0, "C5_A21" <= 1, "C5_A20" <= 1,
                 "C5_A19" <= 0, "C5_A18" <= 1, "C5_A17" <= 0, "C5_A16" <= 0,
                 "C5_A15" <= 0, "C5_A14" <= 1, "C5_A13" <= 0, "C5_A12" <= 1,
                 "C5_A11" <= 0, "C5_A10" <= 1, "C5_A9"  <= 1, "C5_A8"  <= 0,
                 "C5_A7"  <= 0, "C5_A6"  <= 1, "C5_A5"  <= 1, "C5_A4"  <= 1,
                 "C5_A3"  <= 1, "C5_A2"  <= 0, "C5_A1"  <= 0, "C5_A0"  <= 0], 2);
        // C6 reg0: 0xAAAAAAAA
        process(["C6_A31" <= 1, "C6_A30" <= 0, "C6_A29" <= 1, "C6_A28" <= 0,
                 "C6_A27" <= 1, "C6_A26" <= 0, "C6_A25" <= 1, "C6_A24" <= 0,
                 "C6_A23" <= 1, "C6_A22" <= 0, "C6_A21" <= 1, "C6_A20" <= 0,
                 "C6_A19" <= 1, "C6_A18" <= 0, "C6_A17" <= 1, "C6_A16" <= 0,
                 "C6_A15" <= 1, "C6_A14" <= 0, "C6_A13" <= 1, "C6_A12" <= 0,
                 "C6_A11" <= 1, "C6_A10" <= 0, "C6_A9"  <= 1, "C6_A8"  <= 0,
                 "C6_A7"  <= 1, "C6_A6"  <= 0, "C6_A5"  <= 1, "C6_A4"  <= 0,
                 "C6_A3"  <= 1, "C6_A2"  <= 0, "C6_A1"  <= 1, "C6_A0"  <= 0], 2);
        // C7 reg0: 0x00000000
        process(["C7_A31" <= 0, "C7_A30" <= 0, "C7_A29" <= 0, "C7_A28" <= 0,
                 "C7_A27" <= 0, "C7_A26" <= 0, "C7_A25" <= 0, "C7_A24" <= 0,
                 "C7_A23" <= 0, "C7_A22" <= 0, "C7_A21" <= 0, "C7_A20" <= 0,
                 "C7_A19" <= 0, "C7_A18" <= 0, "C7_A17" <= 0, "C7_A16" <= 0,
                 "C7_A15" <= 0, "C7_A14" <= 0, "C7_A13" <= 0, "C7_A12" <= 0,
                 "C7_A11" <= 0, "C7_A10" <= 0, "C7_A9"  <= 0, "C7_A8"  <= 0,
                 "C7_A7"  <= 0, "C7_A6"  <= 0, "C7_A5"  <= 0, "C7_A4"  <= 0,
                 "C7_A3"  <= 0, "C7_A2"  <= 0, "C7_A1"  <= 0, "C7_A0"  <= 0], 2);

        // ── Clock edge: latch all reg0s (S0=0 by default) ────────────────
        process(["CLK" <= 1], 3);
        process(["CLK" <= 0], 4);

        // ── Switch all cores to reg1 write (S0=1), enable read (R=1) ─────
        process(["C0_S0" <= 1, "C0_R" <= 1,
                 "C1_S0" <= 1, "C1_R" <= 1,
                 "C2_S0" <= 1, "C2_R" <= 1,
                 "C3_S0" <= 1, "C3_R" <= 1,
                 "C4_S0" <= 1, "C4_R" <= 1,
                 "C5_S0" <= 1, "C5_R" <= 1,
                 "C6_S0" <= 1, "C6_R" <= 1,
                 "C7_S0" <= 1, "C7_R" <= 1], 5);
        process(["CLK" <= 1], 6);
        process(["CLK" <= 0], 7);

        // ── Set reg1 values for all cores ────────────────────────────────
        // C0 reg1: 0x00000001
        process(["C0_A31" <= 0, "C0_A30" <= 0, "C0_A29" <= 0, "C0_A28" <= 0,
                 "C0_A27" <= 0, "C0_A26" <= 0, "C0_A25" <= 0, "C0_A24" <= 0,
                 "C0_A23" <= 0, "C0_A22" <= 0, "C0_A21" <= 0, "C0_A20" <= 0,
                 "C0_A19" <= 0, "C0_A18" <= 0, "C0_A17" <= 0, "C0_A16" <= 0,
                 "C0_A15" <= 0, "C0_A14" <= 0, "C0_A13" <= 0, "C0_A12" <= 0,
                 "C0_A11" <= 0, "C0_A10" <= 0, "C0_A9"  <= 0, "C0_A8"  <= 0,
                 "C0_A7"  <= 0, "C0_A6"  <= 0, "C0_A5"  <= 0, "C0_A4"  <= 0,
                 "C0_A3"  <= 0, "C0_A2"  <= 0, "C0_A1"  <= 0, "C0_A0"  <= 1], 8);
        // C1 reg1: 0x00000001
        process(["C1_A31" <= 0, "C1_A30" <= 0, "C1_A29" <= 0, "C1_A28" <= 0,
                 "C1_A27" <= 0, "C1_A26" <= 0, "C1_A25" <= 0, "C1_A24" <= 0,
                 "C1_A23" <= 0, "C1_A22" <= 0, "C1_A21" <= 0, "C1_A20" <= 0,
                 "C1_A19" <= 0, "C1_A18" <= 0, "C1_A17" <= 0, "C1_A16" <= 0,
                 "C1_A15" <= 0, "C1_A14" <= 0, "C1_A13" <= 0, "C1_A12" <= 0,
                 "C1_A11" <= 0, "C1_A10" <= 0, "C1_A9"  <= 0, "C1_A8"  <= 0,
                 "C1_A7"  <= 0, "C1_A6"  <= 0, "C1_A5"  <= 0, "C1_A4"  <= 0,
                 "C1_A3"  <= 0, "C1_A2"  <= 0, "C1_A1"  <= 0, "C1_A0"  <= 1], 8);
        // C2 reg1: 0x00000001
        process(["C2_A31" <= 0, "C2_A30" <= 0, "C2_A29" <= 0, "C2_A28" <= 0,
                 "C2_A27" <= 0, "C2_A26" <= 0, "C2_A25" <= 0, "C2_A24" <= 0,
                 "C2_A23" <= 0, "C2_A22" <= 0, "C2_A21" <= 0, "C2_A20" <= 0,
                 "C2_A19" <= 0, "C2_A18" <= 0, "C2_A17" <= 0, "C2_A16" <= 0,
                 "C2_A15" <= 0, "C2_A14" <= 0, "C2_A13" <= 0, "C2_A12" <= 0,
                 "C2_A11" <= 0, "C2_A10" <= 0, "C2_A9"  <= 0, "C2_A8"  <= 0,
                 "C2_A7"  <= 0, "C2_A6"  <= 0, "C2_A5"  <= 0, "C2_A4"  <= 0,
                 "C2_A3"  <= 0, "C2_A2"  <= 0, "C2_A1"  <= 0, "C2_A0"  <= 1], 8);
        // C3 reg1: 0x00005678
        process(["C3_A31" <= 0, "C3_A30" <= 0, "C3_A29" <= 0, "C3_A28" <= 0,
                 "C3_A27" <= 0, "C3_A26" <= 0, "C3_A25" <= 0, "C3_A24" <= 0,
                 "C3_A23" <= 0, "C3_A22" <= 0, "C3_A21" <= 0, "C3_A20" <= 0,
                 "C3_A19" <= 0, "C3_A18" <= 1, "C3_A17" <= 0, "C3_A16" <= 1,
                 "C3_A15" <= 0, "C3_A14" <= 1, "C3_A13" <= 1, "C3_A12" <= 0,
                 "C3_A11" <= 0, "C3_A10" <= 1, "C3_A9"  <= 1, "C3_A8"  <= 1,
                 "C3_A7"  <= 1, "C3_A6"  <= 0, "C3_A5"  <= 0, "C3_A4"  <= 0,
                 "C3_A3"  <= 0, "C3_A2"  <= 0, "C3_A1"  <= 0, "C3_A0"  <= 0], 8);
        // C4 reg1: 0x00000001
        process(["C4_A31" <= 0, "C4_A30" <= 0, "C4_A29" <= 0, "C4_A28" <= 0,
                 "C4_A27" <= 0, "C4_A26" <= 0, "C4_A25" <= 0, "C4_A24" <= 0,
                 "C4_A23" <= 0, "C4_A22" <= 0, "C4_A21" <= 0, "C4_A20" <= 0,
                 "C4_A19" <= 0, "C4_A18" <= 0, "C4_A17" <= 0, "C4_A16" <= 0,
                 "C4_A15" <= 0, "C4_A14" <= 0, "C4_A13" <= 0, "C4_A12" <= 0,
                 "C4_A11" <= 0, "C4_A10" <= 0, "C4_A9"  <= 0, "C4_A8"  <= 0,
                 "C4_A7"  <= 0, "C4_A6"  <= 0, "C4_A5"  <= 0, "C4_A4"  <= 0,
                 "C4_A3"  <= 0, "C4_A2"  <= 0, "C4_A1"  <= 0, "C4_A0"  <= 1], 8);
        // C5 reg1: 0x87654321
        process(["C5_A31" <= 1, "C5_A30" <= 0, "C5_A29" <= 0, "C5_A28" <= 0,
                 "C5_A27" <= 0, "C5_A26" <= 1, "C5_A25" <= 1, "C5_A24" <= 1,
                 "C5_A23" <= 0, "C5_A22" <= 1, "C5_A21" <= 1, "C5_A20" <= 0,
                 "C5_A19" <= 0, "C5_A18" <= 1, "C5_A17" <= 0, "C5_A16" <= 1,
                 "C5_A15" <= 0, "C5_A14" <= 1, "C5_A13" <= 0, "C5_A12" <= 0,
                 "C5_A11" <= 0, "C5_A10" <= 0, "C5_A9"  <= 1, "C5_A8"  <= 1,
                 "C5_A7"  <= 0, "C5_A6"  <= 0, "C5_A5"  <= 1, "C5_A4"  <= 0,
                 "C5_A3"  <= 0, "C5_A2"  <= 0, "C5_A1"  <= 0, "C5_A0"  <= 1], 8);
        // C6 reg1: 0x55555555
        process(["C6_A31" <= 0, "C6_A30" <= 1, "C6_A29" <= 0, "C6_A28" <= 1,
                 "C6_A27" <= 0, "C6_A26" <= 1, "C6_A25" <= 0, "C6_A24" <= 1,
                 "C6_A23" <= 0, "C6_A22" <= 1, "C6_A21" <= 0, "C6_A20" <= 1,
                 "C6_A19" <= 0, "C6_A18" <= 1, "C6_A17" <= 0, "C6_A16" <= 1,
                 "C6_A15" <= 0, "C6_A14" <= 1, "C6_A13" <= 0, "C6_A12" <= 1,
                 "C6_A11" <= 0, "C6_A10" <= 1, "C6_A9"  <= 0, "C6_A8"  <= 1,
                 "C6_A7"  <= 0, "C6_A6"  <= 1, "C6_A5"  <= 0, "C6_A4"  <= 1,
                 "C6_A3"  <= 0, "C6_A2"  <= 1, "C6_A1"  <= 0, "C6_A0"  <= 1], 8);
        // C7 reg1: 0x00000000
        process(["C7_A31" <= 0, "C7_A30" <= 0, "C7_A29" <= 0, "C7_A28" <= 0,
                 "C7_A27" <= 0, "C7_A26" <= 0, "C7_A25" <= 0, "C7_A24" <= 0,
                 "C7_A23" <= 0, "C7_A22" <= 0, "C7_A21" <= 0, "C7_A20" <= 0,
                 "C7_A19" <= 0, "C7_A18" <= 0, "C7_A17" <= 0, "C7_A16" <= 0,
                 "C7_A15" <= 0, "C7_A14" <= 0, "C7_A13" <= 0, "C7_A12" <= 0,
                 "C7_A11" <= 0, "C7_A10" <= 0, "C7_A9"  <= 0, "C7_A8"  <= 0,
                 "C7_A7"  <= 0, "C7_A6"  <= 0, "C7_A5"  <= 0, "C7_A4"  <= 0,
                 "C7_A3"  <= 0, "C7_A2"  <= 0, "C7_A1"  <= 0, "C7_A0"  <= 0], 8);

        // ── Clock edge: latch all reg1s ───────────────────────────────────
        process(["C0_S0" <= 0, "C1_S0" <= 0, "C2_S0" <= 0, "C3_S0" <= 0,
                 "C4_S0" <= 0, "C5_S0" <= 0, "C6_S0" <= 0, "C7_S0" <= 0], 9);
        process(["CLK" <= 1,
                 "C0_S0" <= 1, "C1_S0" <= 1, "C2_S0" <= 1, "C3_S0" <= 1,
                 "C4_S0" <= 1, "C5_S0" <= 1, "C6_S0" <= 1, "C7_S0" <= 1], 10);

        // ── Disable immediate mode on all cores ──────────────────────────
        process(["C0_IM" <= 0, "C1_IM" <= 0, "C2_IM" <= 0, "C3_IM" <= 0,
                 "C4_IM" <= 0, "C5_IM" <= 0, "C6_IM" <= 0, "C7_IM" <= 0], 11);

        // ── Set up SUM on all cores: AI=0 BI=0 Carry=0 op1=1 op0=0 ──────
        process(["C0_AI" <= 0, "C0_BI" <= 0, "C0_Carry" <= 0, "C0_op1" <= 1, "C0_op0" <= 0,
                 "C1_AI" <= 0, "C1_BI" <= 0, "C1_Carry" <= 0, "C1_op1" <= 1, "C1_op0" <= 0,
                 "C2_AI" <= 0, "C2_BI" <= 0, "C2_Carry" <= 0, "C2_op1" <= 1, "C2_op0" <= 0,
                 "C3_AI" <= 0, "C3_BI" <= 0, "C3_Carry" <= 0, "C3_op1" <= 1, "C3_op0" <= 0,
                 "C4_AI" <= 0, "C4_BI" <= 0, "C4_Carry" <= 0, "C4_op1" <= 1, "C4_op0" <= 0,
                 "C5_AI" <= 0, "C5_BI" <= 0, "C5_Carry" <= 0, "C5_op1" <= 1, "C5_op0" <= 0,
                 "C6_AI" <= 0, "C6_BI" <= 0, "C6_Carry" <= 0, "C6_op1" <= 1, "C6_op0" <= 0,
                 "C7_AI" <= 0, "C7_BI" <= 0, "C7_Carry" <= 0, "C7_op1" <= 1, "C7_op0" <= 0], 12);
        process(["CLK" <= 0], 13);

        // ── Enable Ealu on all cores, clock to latch results ─────────────
        process(["C0_Ealu" <= 1, "C1_Ealu" <= 1, "C2_Ealu" <= 1, "C3_Ealu" <= 1,
                 "C4_Ealu" <= 1, "C5_Ealu" <= 1, "C6_Ealu" <= 1, "C7_Ealu" <= 1], 14);
        process(["CLK" <= 1], 15);

        // ── Results latched, disable Ealu ────────────────────────────────
        process(["CLK" <= 0,
                 "C0_Ealu" <= 0, "C1_Ealu" <= 0, "C2_Ealu" <= 0, "C3_Ealu" <= 0,
                 "C4_Ealu" <= 0, "C5_Ealu" <= 0, "C6_Ealu" <= 0, "C7_Ealu" <= 0], 16);
    }
}