simulator singleCoreALU {
    processes {
        process(["CLK" <= 0], 1);

        process(["IM" <= 1], 2);
        process(["A31" <= 0, "A30" <= 1, "A29" <= 0, "A28" <= 1,
                 "A27" <= 0, "A26" <= 1, "A25" <= 0, "A24" <= 1,
                 "A23" <= 0, "A22" <= 1, "A21" <= 0, "A20" <= 1,
                 "A19" <= 0, "A18" <= 1, "A17" <= 0, "A16" <= 1,
                 "A15" <= 0, "A14" <= 1, "A13" <= 0, "A12" <= 1,
                 "A11" <= 0, "A10" <= 1, "A9"  <= 0, "A8"  <= 1,
                 "A7"  <= 0, "A6"  <= 1, "A5"  <= 0, "A4"  <= 1,
                 "A3"  <= 0, "A2"  <= 1, "A1"  <= 0, "A0"  <= 1], 2);

        process(["CLK" <= 1], 3);
        process(["CLK" <= 0], 4);

        process(["S0" <= 1, "R" <= 1], 5);
        process(["CLK" <= 1], 6);
        process(["CLK" <= 0], 7);

        process(["A31" <= 1, "A30" <= 0, "A29" <= 1, "A28" <= 0,
                 "A27" <= 1, "A26" <= 0, "A25" <= 1, "A24" <= 0,
                 "A23" <= 1, "A22" <= 0, "A21" <= 1, "A20" <= 0,
                 "A19" <= 1, "A18" <= 0, "A17" <= 1, "A16" <= 0,
                 "A15" <= 1, "A14" <= 0, "A13" <= 1, "A12" <= 0,
                 "A11" <= 1, "A10" <= 0, "A9"  <= 1, "A8"  <= 0,
                 "A7"  <= 1, "A6"  <= 0, "A5"  <= 1, "A4"  <= 0,
                 "A3"  <= 1, "A2"  <= 0, "A1"  <= 1, "A0"  <= 0], 8);

        process(["S0" <= 0, "R" <= 1], 9);
        process(["CLK" <= 1, "S0" <= 1], 10);

        process(["IM" <= 0], 11);

        process(["AI" <= 0, "BI" <= 0, "Carry" <= 0, "op1" <= 1, "op0" <= 0], 12);
        process(["CLK" <= 0], 13);
        process(["Ealu" <= 1], 14);
        process(["CLK" <= 1], 15);

        process(["CLK" <= 0, "Ealu" <= 0], 16);

        // Load 0xF0F0F0F0 into reg0
        process(["IM" <= 1], 17);
        process(["A31" <= 1, "A30" <= 1, "A29" <= 1, "A28" <= 1,
                 "A27" <= 1, "A26" <= 1, "A25" <= 1, "A24" <= 1,
                 "A23" <= 1, "A22" <= 1, "A21" <= 1, "A20" <= 1,
                 "A19" <= 1, "A18" <= 1, "A17" <= 1, "A16" <= 1,
                 "A15" <= 1, "A14" <= 1, "A13" <= 1, "A12" <= 1,
                 "A11" <= 1, "A10" <= 1, "A9"  <= 1, "A8"  <= 1,
                 "A7"  <= 1, "A6"  <= 1, "A5"  <= 1, "A4"  <= 1,
                 "A3"  <= 1, "A2"  <= 1, "A1"  <= 1, "A0"  <= 1], 17);

        process(["S0" <= 0, "R" <= 1], 18);
        process(["CLK" <= 1], 19);
        process(["CLK" <= 0], 20);

        process(["A31" <= 0, "A30" <= 0, "A29" <= 0, "A28" <= 0,
                 "A27" <= 1, "A26" <= 1, "A25" <= 1, "A24" <= 1,
                 "A23" <= 0, "A22" <= 0, "A21" <= 0, "A20" <= 0,
                 "A19" <= 1, "A18" <= 1, "A17" <= 1, "A16" <= 1,
                 "A15" <= 0, "A14" <= 0, "A13" <= 0, "A12" <= 0,
                 "A11" <= 1, "A10" <= 1, "A9"  <= 1, "A8"  <= 1,
                 "A7"  <= 0, "A6"  <= 0, "A5"  <= 0, "A4"  <= 0,
                 "A3"  <= 1, "A2"  <= 1, "A1"  <= 1, "A0"  <= 1], 20);

        process(["S0" <= 1, "R" <= 1], 21);
        process(["CLK" <= 1], 22);
        process(["CLK" <= 0], 23);

        process(["IM" <= 0], 24);

        process(["AI" <= 0, "BI" <= 0, "Carry" <= 0, "op1" <= 0, "op0" <= 0], 25);
        process(["CLK" <= 0], 26);
        process(["Ealu" <= 1], 27);
        process(["CLK" <= 1], 28);

        process(["CLK" <= 0, "Ealu" <= 0], 29);
    }
}