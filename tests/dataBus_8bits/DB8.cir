entity DB8 {
    inputs : ["A0", "A1", "A2", "A3", "A4", "A5", "A6", "A7",
              "F0", "F1", "F2", "F3", "F4", "F5", "F6", "F7",
              "IM"];
    outputs : ["DB0", "DB1", "DB2", "DB3", "DB4", "DB5", "DB6", "DB7"];
}

architecture DB8 {
    signals : ["A0", "A1", "A2", "A3", "A4", "A5", "A6", "A7",
              "F0", "F1", "F2", "F3", "F4", "F5", "F6", "F7",
              "IM", "DB0", "DB1", "DB2", "DB3", "DB4", "DB5", 
              "DB6", "DB7", "FF"];

    signalMapping : [
        "A0" <= "A0",
        "A1" <= "A1",
        "A2" <= "A2",
        "A3" <= "A3",
        "A4" <= "A4",
        "A5" <= "A5",
        "A6" <= "A6",
        "A7" <= "A7",

        "F0" <= "F0",
        "F1" <= "F1",
        "F2" <= "F2",
        "F3" <= "F3",
        "F4" <= "F4",
        "F5" <= "F5",
        "F6" <= "F6",
        "F7" <= "F7",

        "DB0" <= "DB0",
        "DB1" <= "DB1",
        "DB2" <= "DB2",
        "DB3" <= "DB3",
        "DB4" <= "DB4",
        "DB5" <= "DB5",
        "DB6" <= "DB6",
        "DB7" <= "DB7",

        "IM" <= "IM"
    ];
    behaviour {
        FF <= not(IM);

        DB0 <= (A0 and IM) or (F0 and FF);
        DB1 <= (A1 and IM) or (F1 and FF);
        DB2 <= (A2 and IM) or (F2 and FF);
        DB3 <= (A3 and IM) or (F3 and FF);
        DB4 <= (A4 and IM) or (F4 and FF);
        DB5 <= (A5 and IM) or (F5 and FF);
        DB6 <= (A6 and IM) or (F6 and FF);
        DB7 <= (A7 and IM) or (F7 and FF);
    }
}